{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "plugins": [{"name": "next"}]
  },
  "include": ["app/**/*.js", "lib/**/*.js", ".next/types/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
